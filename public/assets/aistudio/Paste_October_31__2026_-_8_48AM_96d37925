 <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
 <script>
   let currentStudent = null;
   let examTimer = null;
   let remainingSeconds = 0;
   let totalSeconds = 0;
   let examStarted = false;
   let adminName = '';

   document.addEventListener('DOMContentLoaded', function(){
     showLoading(true);
     google.script.run.withSuccessHandler(initUI).getLogoAndTitles();
     google.script.run.withSuccessHandler(populateLevels).getLevels();
     showLoading(false);

     document.getElementById('roleSelect').addEventListener('change', function(){
       const r = this.value;
       document.getElementById('formSiswa').style.display = r === 'siswa' ? '' : 'none';
       document.getElementById('formAdmin').style.display = r === 'siswa' ? 'none' : '';
     });

     document.getElementById('tingkatSelect').addEventListener('change', function(){
       const t = this.value;
       if(!t) return;
       showLoading(true);
       google.script.run.withSuccessHandler(function(classes){
         fillSelect('kelasSelect', classes, '-- Pilih Kelas --');
         showLoading(false);
       }).getClassesForLevel(t);
       google.script.run.withSuccessHandler(function(subjects){
         fillSelect('mataSelect', subjects, '-- Pilih Mata Pelajaran --');
       }).getSubjectsForLevel(t);
     });

     document.getElementById('loginSiswaBtn').addEventListener('click', onLoginSiswa);
     document.getElementById('loginAdminBtn').addEventListener('click', onLoginAdmin);
     document.getElementById('mulaiUjianBtn').addEventListener('click', onMulaiUjian);
     document.getElementById('tokenSubmitBtn').addEventListener('click', submitToken);
     document.getElementById('logoutBtn').addEventListener('click', logoutToLogin);
     document.getElementById('logoutAdminBtn').addEventListener('click', logoutToLogin);
     document.getElementById('finishBtn').addEventListener('click', () => finishExam(true));
     
     // Setup Pengaman Ujian
     setupExamSecurity();
   });

   function showLoading(show){ document.getElementById('loadingOverlay').style.display = show ? 'flex' : 'none'; }
   function initUI(data){
     if(data){
       document.getElementById('appLogo').src = data.logoUrl || '';
       document.getElementById('logoLink').href = data.logoUrl || '#';
       document.getElementById('appTitle').textContent = data.title || 'Ujian Online';
       document.getElementById('appSubtitle').textContent = data.subtitle || '';
     }
   }
   function populateLevels(levels){ fillSelect('tingkatSelect', levels, '-- Pilih Tingkat --'); }
   function fillSelect(id, arr, placeholder){
     const sel = document.getElementById(id);
     sel.innerHTML = '';
     const opt0 = document.createElement('option');
     opt0.value = ''; opt0.textContent = placeholder || '-- Pilih --';
     sel.appendChild(opt0);
     (arr||[]).forEach(v=>{ const o=document.createElement('option'); o.value=v; o.textContent=v; sel.appendChild(o); });
   }

   /* ---------- FULLSCREEN HANDLER ---------- */
   function enterFullScreen() {
     const elem = document.documentElement;
     if (elem.requestFullscreen) { elem.requestFullscreen(); }
     else if (elem.webkitRequestFullscreen) { elem.webkitRequestFullscreen(); }
     else if (elem.msRequestFullscreen) { elem.msRequestFullscreen(); }
   }

   function exitFullScreen() {
     if (document.exitFullscreen) { document.exitFullscreen(); }
     else if (document.webkitExitFullscreen) { document.webkitExitFullscreen(); }
     else if (document.msExitFullscreen) { document.msExitFullscreen(); }
   }

   /* ---------- SISTEM KEAMANAN (ANTI CHEAT) ---------- */
   function setupExamSecurity() {
     // 1. Blokir Klik Kanan
     document.addEventListener('contextmenu', e => {
       if (examStarted) e.preventDefault();
     });

     // 2. Blokir Tombol Pintas & Shortcut Keyboard (Alt+Tab, Ctrl+C, F12, dsb.)
     document.addEventListener('keydown', e => {
       if (!examStarted) return;
       if (e.key === "Tab" || e.altKey || e.ctrlKey || e.metaKey || e.key === "F12" || (e.ctrlKey && e.shiftKey && e.key === 'I')) {
         e.preventDefault();
         triggerViolation("Kombinasi tombol keyboard dilarang selama ujian!");
       }
     });

     // 3. Deteksi Berpindah Tab / Window Blur
     window.addEventListener('blur', () => {
       if (examStarted) triggerViolation("Anda meninggalkan area ujian / membuka aplikasi lain!");
     });

     document.addEventListener('visibilitychange', () => {
       if (document.hidden && examStarted) {
         triggerViolation("Anda berpindah tab/layar!");
       }
     });
   }

   function triggerViolation(reason) {
     if (!examStarted || !currentStudent) return;
     examStarted = false;
     if (examTimer) clearInterval(examTimer);

     // Ubah status siswa menjadi Tidak Aktif di spreadsheet
     google.script.run.setStatusInactive(currentStudent.nisn);

     Swal.fire({
       icon: 'error',
       title: 'Pelanggaran Terdeteksi!',
       text: reason + ' Status ujian Anda telah dinonaktifkan.',
       allowOutsideClick: false,
       allowEscapeKey: false
     }).then(() => {
       exitFullScreen();
       logoutToLogin();
     });
   }

   /* ---------- LOGIN & NAVIGASI ---------- */
   function onLoginSiswa(){
     const nisn = document.getElementById('nisnInput').value.trim();
     const tingkat = document.getElementById('tingkatSelect').value;
     const kelas = document.getElementById('kelasSelect').value;
     const mata = document.getElementById('mataSelect').value;

     if(!nisn || !tingkat || !kelas || !mata){
       Swal.fire({ icon:'warning', title:'Lengkapi Form', text:'Isi seluruh kolom terlebih dahulu.' });
       return;
     }

     showLoading(true);
     google.script.run.withSuccessHandler(function(resp){
       showLoading(false);
       if(resp.success){
         currentStudent = resp.data;
         document.getElementById('studentName').textContent = currentStudent.nama;
         document.getElementById('loginBox').style.display = 'none';
         document.getElementById('studentContent').style.display = 'block';
         document.getElementById('dNama').textContent = currentStudent.nama;
         document.getElementById('dNISN').textContent = currentStudent.nisn;
         document.getElementById('dTingkat').textContent = currentStudent.tingkat;
         document.getElementById('dKelas').textContent = currentStudent.kelas;
         document.getElementById('dMata').textContent = currentStudent.mataPelajaran;
         document.getElementById('dWaktu').textContent = currentStudent.waktuMenit || 0;
       } else {
         Swal.fire({ icon:'error', title:'Gagal', text: resp.message || 'Autentikasi gagal.' });
       }
     }).authenticateStudent(nisn, tingkat, kelas, mata);
   }

   function onLoginAdmin(){
     const user = document.getElementById('adminUser').value.trim();
     const pass = document.getElementById('adminPass').value || '';
     if(!user || !pass){ Swal.fire({ icon:'warning', title:'Lengkapi', text:'Masukkan username & password.' }); return; }

     showLoading(true);
     google.script.run.withSuccessHandler(function(resp){
       showLoading(false);
       if(resp.success){
         adminName = resp.name || user;
         document.getElementById('loginBox').style.display = 'none';
         document.getElementById('adminShell').style.display = 'block';
         document.getElementById('adminWelcome').textContent = 'Halo, ' + adminName;
         loadDashboardCounts();
       } else {
         Swal.fire({ icon:'error', title:'Gagal', text: resp.message });
       }
     }).authenticateAdmin(user, pass);
   }

   function logoutToLogin(){
     currentStudent = null;
     examStarted = false;
     if(examTimer) clearInterval(examTimer);
     exitFullScreen();

     document.getElementById('studentContent').style.display = 'none';
     document.getElementById('adminShell').style.display = 'none';
     document.getElementById('loginBox').style.display = 'block';
     document.getElementById('soalIframe').src = '';
     document.getElementById('examArea').style.display = 'none';
     document.querySelector('.card-identitas').style.display = 'block';
   }

   function onMulaiUjian(){
     if(!currentStudent) return;
     new bootstrap.Modal(document.getElementById('tokenModal')).show();
   }

   function submitToken(){
     const token = document.getElementById('tokenInput').value.trim();
     if(!token){ Swal.fire({ icon:'warning', title:'Token Kosong', text:'Masukkan token ujian.' }); return; }

     showLoading(true);
     google.script.run.withSuccessHandler(function(resp){
       showLoading(false);
       if(resp.success){
         bootstrap.Modal.getInstance(document.getElementById('tokenModal')).hide();
         startExam(resp.durationMinutes, resp.link);
       } else {
         Swal.fire({ icon:'error', title:'Token Salah', text: resp.message });
       }
     }).validateToken(currentStudent.tingkat, currentStudent.mataPelajaran, token);
   }

   function startExam(durationMinutes, link) {
     totalSeconds = Math.max(0, Math.floor(Number(durationMinutes) * 60));
     remainingSeconds = totalSeconds;
     
     if (!link) {
       Swal.fire({ icon: 'error', title: 'Link Soal Kosong' });
       return;
     }

     // Aktifkan Layar Penuh
     enterFullScreen();

     document.querySelector('.card-identitas').style.display = 'none';
     document.getElementById('examArea').style.display = 'flex';
     document.getElementById('soalIframe').src = link;

     examStarted = true;
     updateTimerDisplay();

     if (examTimer) clearInterval(examTimer);
     examTimer = setInterval(function () {
       remainingSeconds--;
       if (remainingSeconds <= 0) {
         clearInterval(examTimer);
         finishExam(false);
       } else {
         updateTimerDisplay();
       }
     }, 1000);
   }

   function updateTimerDisplay() {
     const h = Math.floor(remainingSeconds / 3600);
     const m = Math.floor((remainingSeconds % 3600) / 60);
     const s = remainingSeconds % 60;
     document.getElementById('timerDisplay').textContent = 
       `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
     
     const progress = (remainingSeconds / totalSeconds) * 100;
     document.getElementById('timeProgress').style.width = `${progress}%`;
   }

   function finishExam(manual = true) {
     const processFinish = () => {
       examStarted = false;
       if (examTimer) clearInterval(examTimer);
       if (currentStudent) google.script.run.setStatusInactive(currentStudent.nisn);

       Swal.fire({
         icon: 'success',
         title: 'Ujian Selesai',
         text: 'Terima kasih telah mengikuti ujian.',
         timer: 2000,
         showConfirmButton: false
       }).then(() => logoutToLogin());
     };

     if (manual) {
       Swal.fire({
         title: 'Akhiri Ujian?',
         text: 'Apakah Anda yakin ingin menyelesaikan ujian?',
         icon: 'question',
         showCancelButton: true,
         confirmButtonText: 'Ya, Selesai'
       }).then((result) => {
         if (result.isConfirmed) processFinish();
       });
     } else {
       Swal.fire({ icon: 'warning', title: 'Waktu Habis', text: 'Ujian berakhir otomatis.' });
       processFinish();
     }
   }

   /* ---------- FUNCTION ADMIN & DATA TABLE (TETAP SAMA) ---------- */
   function loadDashboardCounts(){
     google.script.run.withSuccessHandler(function(c){
       document.getElementById('countTotal').textContent = c.total || 0;
       document.getElementById('countAktif').textContent = c.aktif || 0;
       document.getElementById('countTidakAktif').textContent = c.tidakAktif || 0;
     }).getAdminCounts();
   }
 </script>
