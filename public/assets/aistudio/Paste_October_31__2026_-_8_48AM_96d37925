<!DOCTYPE html>
<html lang="id">
<head>
 <meta charset="utf-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
 <title>Ujian Online</title>
 <!-- Bootstrap 5 -->
 <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet"/>
 <!-- FontAwesome -->
 <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
 <!-- SweetAlert2 -->
 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
 <style>
 body, html {
   height: 100%;
   margin: 0;
   background: linear-gradient(135deg, #f8f9fc, #dbeafe);
   font-family: 'Segoe UI', sans-serif;
   user-select: none; /* Mencegah seleksi teks */
   -webkit-user-select: none;
 }
 #loginBox {
   max-width:420px;
   width:94%;
   margin:auto;
   position: absolute;
   top:50%;
   left:50%;
   transform: translate(-50%, -50%);
   background: #ffffff;
   border-radius: 15px;
   box-shadow: 0 10px 30px rgba(0,0,0,0.1);
   padding: 30px;
 }
 #loginBox img.logo { max-width:85px; display:block; margin:0 auto 15px auto; }
 .small-muted { font-size:0.9rem; color:#6c757d; }
 .overlay-loading {
   position:fixed; inset:0; display:flex; align-items:center; justify-content:center;
   background:rgba(255,255,255,0.7); z-index:9999; display:none;
 }
 #studentContent {
   display:none;
   height:100vh;
   width:100%;
   overflow-y:auto;
   padding:15px;
   background: linear-gradient(135deg,#e0f2fe,#f8fafc);
 }
 .navbar-top {
   background: #2563eb;
   color: #fff;
   padding: 12px 20px;
   display: flex;
   justify-content: space-between;
   align-items: center;
   border-radius: 10px;
   box-shadow: 0 2px 8px rgba(0,0,0,0.1);
 }
 .navbar-top h5 { margin: 0; font-weight: 600; }
 .profile-menu { position: relative; display: flex; align-items: center; cursor: pointer; }
 .profile-icon {
   width: 38px; height: 38px; background-color: #1e40af; border-radius: 50%;
   display: flex; justify-content: center; align-items: center; font-size: 18px; color: white;
 }
 .student-name { margin-left: 10px; font-weight: 500; color: #fff; user-select: none; }
 .dropdown-menu-profile {
   position: absolute; top: 50px; right: 0; background: white; border-radius: 8px;
   box-shadow: 0 4px 10px rgba(0,0,0,0.1); min-width: 150px; display: none;
   flex-direction: column; z-index: 10;
 }
 .dropdown-menu-profile.show { display: flex; animation: fadeIn 0.2s ease-in-out; }
 .dropdown-menu-profile button {
   background: none; border: none; text-align: left; padding: 10px 15px; font-size: 14px; color: #333; width: 100%;
 }
 .card-identitas {
   background:white; border-radius:16px; box-shadow:0 4px 20px rgba(0,0,0,0.05); padding:20px; margin-top:20px;
 }
 .identitas-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap:12px 20px; }
 .identitas-item { background:#f1f5f9; border-radius:10px; padding:12px 16px; }
 .identitas-item strong { display:block; color:#0f172a; font-size:0.85rem; margin-bottom:4px; }
 .btn-ujian { margin-top:25px; padding:12px 28px; border-radius:50px; font-weight:600; }

 /* PERBAIKAN RESPONSIVE IFRAME (MENCEGAH SALAH KLIK JAWABAN) */
 #examArea { margin-top:15px; height: calc(100vh - 120px); display: flex; flex-direction: column; }
 .iframe-wrapper {
   flex: 1;
   width: 100%;
   height: 100%;
   border-radius: 12px;
   overflow: hidden;
   box-shadow: 0 4px 15px rgba(0,0,0,0.1);
   background: #fff;
 }
 .iframe-wrapper iframe {
   width: 100%;
   height: 100%;
   border: none;
 }

 /* ADMIN LAYOUT */
 #adminShell { display: none; height: 100vh; overflow: hidden; }
 #adminSidebar {
   width: 260px; height: 100vh; background: #2563eb; color: #fff; position: fixed;
   left: 0; top: 0; bottom: 0; padding: 20px 16px; box-shadow: 3px 0 10px rgba(0, 0, 0, 0.15);
   transition: transform 0.25s ease; z-index: 1051; display: flex; flex-direction: column;
 }
 #adminSidebar .brand { display: flex; flex-direction: column; align-items: center; margin-bottom: 18px; }
 #adminSidebar .nav-link { color: #e0e7ff; padding: 10px 12px; border-radius: 8px; margin-bottom: 6px; text-decoration: none; display: flex; align-items: center;}
 #adminSidebar .nav-link.active { background: #1e40af; color: #fff; font-weight: 600; }
 #adminMain { margin-left: 260px; padding: 18px; transition: margin-left 0.25s ease; overflow-y: auto; height: 100vh; }
 #adminMain.full { margin-left: 0; }
 .admin-topbar { display: flex; align-items: center; justify-content: space-between; background-color: #2563eb; color: white; padding: 10px 15px; border-radius: 8px; }
 .stat-card { border-radius: 12px; padding: 14px; background: #fff; box-shadow: 0 6px 18px rgba(2, 6, 23, 0.06); }
 .table-wrap { width: 100%; overflow-x: auto; }

 @media (max-width: 991.98px) {
   #adminSidebar { transform: translateX(-100%); }
   #adminSidebar.show { transform: translateX(0); }
   #adminMain { margin-left: 0 !important; }
 }
 #timerDisplay { font-family: 'Courier New', monospace; letter-spacing: 2px; }
 .btn-finish-exam {
   background: linear-gradient(135deg, #ff4e50, #f9d423); color: white; border: none;
   font-weight: 600; padding: 8px 16px; border-radius: 50px; display: inline-flex; align-items: center; gap: 8px;
 }
 </style>
</head>
<body>
 <!-- Loading -->
 <div class="overlay-loading" id="loadingOverlay">
   <div class="text-center">
     <div class="spinner-border text-primary" role="status"></div>
     <div class="mt-2 fw-semibold">Memproses...</div>
   </div>
 </div>

 <!-- LOGIN BOX -->
